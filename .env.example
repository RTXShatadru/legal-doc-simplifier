# Shared login and AI configuration for all workspaces.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_PROVIDER=local
AUTH_PROVIDER=local
JWT_SECRET=
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8002,http://127.0.0.1:8002
OCR_LANGUAGES=hin+eng
TESSERACT_CMD=
# Optional Clerk authentication (all three values must belong to one instance).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=

# Optional image-capable Groq model for handwritten medical pages.
# Default local OCR needs Tesseract. Vision requires a separately supported model.
MEDICAL_IMAGE_READER=ocr
GROQ_VISION_MODEL=
