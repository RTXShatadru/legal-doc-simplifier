# Copy to .env at the project root. Never commit credentials.
APP_ENV=development
# Groq runs analysis and document chat with Llama 3.1 8B.
# Use AI_PROVIDER=demo only for an explicit offline preview without AI.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDING_PROVIDER=local
# Set a random 32+ character value for persistent sessions. Required in production.
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# For PostgreSQL (pgvector extension must be available):
# DATABASE_URL=postgresql://plainly:your-password@localhost:5432/plainly

# Free-tier AI: set AI_PROVIDER=gemini and your Google AI Studio key.
# Keep EMBEDDING_PROVIDER=local to avoid a separate embedding service.
# AI_PROVIDER=gemini
# Optional paid semantic retrieval: EMBEDDING_PROVIDER=voyage
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
# Embedding dimensions are fixed per provider. Changing provider/model requires
# a fresh database or an explicit embedding migration, never silent mixing.

# Optional Google sign-in: leave ALL three blank until configured.
# See docs/GOOGLE_SIGN_IN.md. The redirect must match Google Cloud exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Local example: http://127.0.0.1:8000/api/auth/google/callback

# Optional: full Tesseract executable path if it is not automatically discovered.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANGUAGES=hin+eng

# Local AI: install Ollama, then ollama pull qwen3:4b-instruct-2507-q4_K_M. No key needed.
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Set to clerk after supplying your matching Clerk keys. See docs/CLERK.md.
AUTH_PROVIDER=local
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
